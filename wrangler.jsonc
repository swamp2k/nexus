{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexus",
  "compatibility_date": "2026-08-27",
  "main": "./worker/index.ts",
  "vars": {
    "MAIL_FROM": "login@nexus.starrewards.app",
    "ENERGY_PRICE_AREA": "DK1",
    "ENERGY_GRID_PROVIDER": "Konstant",
    "ENERGY_SUPPLIER_MARKUP_OERE": "0",
    "WEATHER_LAT": "56.1944",
    "WEATHER_LON": "10.6821",
    "WEATHER_LABEL": "Ebeltoft",
    "MIYAGI_MODEL": "claude-sonnet-4-6"
  },
  "triggers": {
    "crons": ["0 7 * * *", "0 8 * * *"]
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus",
      "database_id": "e2d4b9fe-1d9b-4e24-9f48-6cf54fa758df",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "nexus-data"
    }
  ]
}